# ── Environment Configuration Template (Copy to .env and fill in values) ──

TRADING_MODE=live
EXECUTION_ENABLED=false
DRY_RUN=true
FLASHBLOCKS_ENABLED=true
FLASHBLOCKS_WS_URL=wss://mainnet.flashblocks.base.org/ws
FLASHBLOCKS_INCLUDE_TRANSACTIONS=true

# ── EVM Wallet (Base Mainnet) ─────────────────────────────────────────────────
PRIVATE_KEY=your_private_key_here
BASE_DEPLOYER_KEY=your_deployer_key_here
PROFIT_WALLET=your_wallet_address_here

# ── Telegram Alerts ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ── API Keys ──────────────────────────────────────────────────────────────────
BASESCAN_API_KEY=your_basescan_api_key

# ── Base RPC & WebSocket Endpoints ─────────────────────────────────────────────
BASE_RPC_URL=https://mainnet.base.org
BASE_WS_URL=wss://base-rpc.publicnode.com

# ── Arbitrage & Execution Controls ────────────────────────────────────────────
ARBITRAGE_EXECUTOR_ADDRESS=0x1c21baaf2537de60daad1f2185b9d7823a56cd85
MIN_PROFIT_USD=1.20
MAX_SIZE_USD=20000
MIN_ALERT_SPREAD_BPS=0.0
MAX_OPPORTUNITY_AGE_MS=5000
GAS_LIMIT=650000
MAX_FEE_PER_GAS_GWEI=0.1
MAX_PRIORITY_FEE_PER_GAS_GWEI=0.01
SLIPPAGE_TOLERANCE_BPS=50
RECHECK_PRICE_BEFORE_EXECUTE=true
PROFIT_SURPLUS_SAFETY_BUFFER_BPS=2500
USE_FASTEST_TICKER_INTERVAL=true
FAST_POLL_INTERVAL_MS=200
CONCURRENT_POOL_BATCH_SIZE=12
LOK_SAFETY_GATE_ENABLED=true
MAX_PENDING_TX=1
NONCE_EXPIRY_MS=12000
MAX_RETRIES=2
CONFIRMATION_TIMEOUT_MS=30000
GAS_MULTIPLIER=1.2
MAX_GAS_PRICE_WEI=1000000000
SIMULATE_TRANSACTION=true
AUTO_FAILOVER_ENABLED=true
FAILOVER_ERROR_THRESHOLD=3
HEALTH_CHECK_INTERVAL_MS=30000
PREFLIGHT_SIMULATION_ENABLED=true
DRY_RUN_EXECUTION_LOGGING=true
PREFLIGHT_STRICT_CHECKS=true
DYNAMIC_BASE_FEE_PREDICTION=true
FINGERPRINT_PARITY_GATE=true
CAMPAIGN_LOGGING_ENABLED=true
